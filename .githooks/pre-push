#!/usr/bin/env bash
set -euo pipefail

blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in
    refs/heads/tmp/ai/*)
      echo "ERROR: push blocked for temporary branch: ${local_ref}" >&2
      blocked=1
      ;;
  esac
done

if [ "$blocked" -ne 0 ]; then
  echo "Hint: promote commits to a non-temporary branch before pushing." >&2
  exit 1
fi

exit 0
