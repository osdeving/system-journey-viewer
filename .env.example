# Web (development only, used by Vite proxy)
CODEX_GATEWAY_URL=http://localhost:8787

# Codex gateway
CODEX_GATEWAY_PORT=8787
CODEX_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
CODEX_MODEL=gpt-5-codex
CODEX_WORKDIR=.
CODEX_SANDBOX_MODE=workspace-write
CODEX_APPROVAL_POLICY=on-request
CODEX_SKIP_GIT_REPO_CHECK=false
CODEX_NETWORK_ACCESS_ENABLED=true
