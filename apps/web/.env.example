# Public browser variables for the SJV web app.
# For Vercel + Supabase integration, the build also accepts SUPABASE_URL/SUPABASE_ANON_KEY
# and maps only those safe values into the browser bundle.

# Optional: force a standalone local IndexedDB provider. When set, this takes
# precedence over Supabase for workspace/script/gallery cloud features.
# VITE_SJV_DB_URL=indexeddb://sjv-local

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional compatibility alias used by some Vercel Supabase installs:
# VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
