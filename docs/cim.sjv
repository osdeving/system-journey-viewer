workspace "Customer Interaction Management - System Journey" {
  view v_main container {
    system guardian "Guardian" tech system
    system autopilot "Autopilot" tech system
    gateway api_gateway "Axway" tech nginx
    security oam "OAM" tech oauth2

    container cim "CIM - Customer Interaction Management" tech spring-boot drilldown v_component_cim
    container saga "CIM Saga" tech spring-boot drilldown v_component_saga
    container finish "Finish Interaction Service" tech spring-boot drilldown v_component_finish

    db core_db "Saga Database" tech postgres
    system protocol "Party Interaction" tech system

    queue topic_protocol_create "cim.protocol.create" tech kafka
    queue topic_protocol_created "cim.protocol.created" tech kafka
    queue topic_interaction "ci.interaction" tech kafka

    note note_auth on cim "Requires OAuth2 client credentials"
    note note_events on saga "Saga consumes and publishes Kafka events"

    e_guardian_gateway: guardian -> api_gateway : http "start interaction"
    e_gateway_cim: api_gateway -> cim : http "forward payload"
    e_cim_oam: cim -> oam : oauth2-token "validate token"
    e_cim_saga: cim -> saga : http "start orchestration"
    e_saga_db_create: saga -> core_db : sql "persist CALL_STARTED"
    e_saga_topic_create: saga -> topic_protocol_create : kafka-event "request protocol creation"
    e_protocol_consume_create: protocol -> topic_protocol_create : kafka-event "consume protocol request"
    e_protocol_publish_created: protocol -> topic_protocol_created : kafka-event "publish protocol created"
    e_saga_consume_created: saga -> topic_protocol_created : kafka-event "consume protocol created"
    e_saga_db_update: saga -> core_db : http "persist protocol"
    e_saga_cim_return: saga -> cim : http "return interaction_id"
    e_cim_gateway_return: cim -> api_gateway : http "return interaction_id"
    e_gateway_guardian_return: api_gateway -> guardian : http "return interaction_id"
    e_guardian_autopilot: guardian -> autopilot : http "dispatch interaction"
    e_finish_topic_interaction: finish -> topic_interaction : kafka-event "publish interaction completed"

    journey j_call_start "Call Start + Protocol" color #2563eb {
      e_guardian_gateway
      e_gateway_cim
      e_cim_oam
      e_cim_saga
      e_saga_db_create
      e_saga_topic_create
      e_protocol_consume_create
      e_protocol_publish_created
      e_saga_consume_created
      e_saga_db_update
      e_saga_cim_return
      e_cim_gateway_return
      e_gateway_guardian_return
      e_guardian_autopilot
    }

    journey j_finish "Finish Interaction" color #16a34a {
      e_guardian_autopilot
      e_finish_topic_interaction
    }
  }

  view v_component_cim component parent v_main via cim {
    boundary cim_core "CIM Core" contains cim_app,cim_repo,cim_events

    component cim_app "InteractionApplicationService" tech application-service drilldown v_hex_cim
    component cim_repo "InteractionRepository" tech component
    component cim_events "InteractionEventPublisher" tech adapter-out

    note note_cim_validation on cim_app "Input validation and idempotency checks"

    e_cim_app_repo: cim_app -> cim_repo : internal-call "save aggregate"
    e_cim_app_events: cim_app -> cim_events : internal-call "publish domain event"

    journey j_cim_component "CIM Component Flow" color #22c55e {
      e_cim_app_repo
      e_cim_app_events
    }
  }

  view v_component_saga component parent v_main via saga {
    boundary saga_core "Saga Core" contains saga_app,saga_repo,saga_handlers

    component saga_app "SagaApplicationService" tech application-service drilldown v_hex_saga
    component saga_repo "SagaRepository" tech component
    component saga_handlers "SagaKafkaHandlers" tech adapter-in

    e_saga_handlers_app: saga_handlers -> saga_app : internal-call "consume command"
    e_saga_app_repo: saga_app -> saga_repo : internal-call "persist state"

    journey j_saga_component "Saga Component Flow" color #f59e0b {
      e_saga_handlers_app
      e_saga_app_repo
    }
  }

  view v_component_finish component parent v_main via finish {
    component finish_app "FinishApplicationService" tech application-service drilldown v_hex_finish
    component finish_publisher "FinishPublisher" tech adapter-out

    e_finish_publish: finish_app -> finish_publisher : internal-call "emit completion event"

    journey j_finish_component "Finish Component Flow" color #a855f7 {
      e_finish_publish
    }
  }

  view v_hex_cim hex parent v_component_cim via cim_app {
    domain cim_domain "Interaction Domain" tech domain
    port-in cim_in "CreateInteractionUseCase" tech port-in
    port-out cim_out "InteractionPersistencePort" tech port-out
    adapter-in cim_rest "InteractionController" tech adapter-in
    adapter-out cim_mongo "MongoInteractionRepository" tech adapter-out

    e_cim_rest_in: cim_rest -> cim_in : http "invoke use case"
    e_cim_in_domain: cim_in -> cim_domain : internal-call "execute domain logic"
    e_cim_domain_out: cim_domain -> cim_out : internal-call "request persistence"
    e_cim_out_mongo: cim_out -> cim_mongo : internal-call "save document"
  }

  view v_hex_saga hex parent v_component_saga via saga_app {
    domain saga_domain "Saga Domain" tech domain
    port-in saga_in "AdvanceSagaUseCase" tech port-in
    port-out saga_out "SagaStorePort" tech port-out
    adapter-in saga_kafka_in "SagaKafkaConsumer" tech adapter-in
    adapter-out saga_pg "PostgresSagaStore" tech adapter-out

    e_saga_kafka_in: saga_kafka_in -> saga_in : kafka-event "consume event"
    e_saga_in_domain: saga_in -> saga_domain : internal-call "advance saga"
    e_saga_domain_out: saga_domain -> saga_out : internal-call "persist state"
    e_saga_out_pg: saga_out -> saga_pg : sql "update record"
  }

  view v_hex_finish hex parent v_component_finish via finish_app {
    domain finish_domain "Finish Domain" tech domain
    port-in finish_in "FinishInteractionUseCase" tech port-in
    port-out finish_out "PublishInteractionPort" tech port-out
    adapter-in finish_http "FinishController" tech adapter-in
    adapter-out finish_kafka "KafkaInteractionPublisher" tech adapter-out

    e_finish_http_in: finish_http -> finish_in : http "finish interaction"
    e_finish_in_domain: finish_in -> finish_domain : internal-call "validate transition"
    e_finish_domain_out: finish_domain -> finish_out : internal-call "publish outcome"
    e_finish_out_kafka: finish_out -> finish_kafka : kafka-event "publish event"
  }

  metadata ui-layout {
    view v_main {
      node guardian at 80 100 size 220 120
      node autopilot at 80 340 size 220 120
      node api_gateway at 360 100 size 220 120
      node cim at 640 100 size 260 130
      node saga at 960 100 size 240 130
      node finish at 1260 100 size 240 130
      node core_db at 960 330 size 240 120
      node protocol at 1260 330 size 220 120
      node topic_protocol_create at 640 330 size 260 110
      node topic_protocol_created at 1260 520 size 260 110
      node topic_interaction at 1560 330 size 240 110
      node note_auth at 640 20 size 260 90
      node note_events at 960 20 size 280 90
      edge e_guardian_gateway label 0.5 side left
      edge e_gateway_cim label 0.5 side left
      edge e_cim_saga label 0.46 side left
      edge e_saga_db_create label 0.45 side left
      edge e_saga_topic_create label 0.52 side left
      edge e_protocol_publish_created label 0.48 side right
      edge e_saga_db_update label 0.58 side right
      edge e_guardian_autopilot label 0.5 side left
      edge e_finish_topic_interaction label 0.5 side left
    }
  }
}
